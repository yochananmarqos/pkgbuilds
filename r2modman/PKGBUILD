# https://aur.archlinux.org/packages/r2modman

pkgname=r2modman
pkgver=3.2.19
pkgrel=1
_electronversion=38
pkgdesc="A simple and easy to use mod manager for several games using Thunderstore."
arch=('x86_64')
url="https://github.com/ebkr/r2modmanPlus"
license=('MIT')
depends=("electron${_electronversion}")
makedepends=(
  'git'
  'pnpm'
)
_commit=0fd8dfc7fb444bf6f6923ff3361f05900d348a51  # actually 3.2.19
source=("git+https://github.com/ebkr/r2modmanPlus.git#commit=${_commit}"
# source=("r2modmanPlus-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "$pkgname.desktop"
        "$pkgname.sh")
sha256sums=('d2bdacaadedadd13496ff86f3b21157fc5c7166a660cd8e3038aad0876b816cb'
            '6cd96385f1ad7bf6fec0f9a70b429305e6f20153528e415d3c943ff19a45fd0f'
            '69bfddb149a1597d87c1f2ed3f132a32865273e78a1cdde39ad2d39a0615b7dd')

prepare() {
  cd "${pkgname}Plus"
  electronDist="/usr/lib/electron${_electronversion}"
  electronVer="$(sed s/^v// /usr/lib/electron${_electronversion}/version)"
  export PNPM_HOME="$srcdir/pnpm-home"

  # Modify electron-builder config
  sed -e "s/'AppImage', 'tar.gz', 'deb', 'rpm', 'pacman'/'dir'/" -e "/builder: {/a electronDist: \"${electronDist}\", electronVersion: \"${electronVer}\"," -i quasar.config.ts

  pnpm install --frozen-lockfile

  sed -i "s|@ELECTRONVERSION@|${_electronversion}|" "$srcdir/$pkgname.sh"
}

build() {
  cd "${pkgname}Plus"
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1
  electronDist="/usr/lib/electron${_electronversion}"
  electronVer="$(sed s/^v// /usr/lib/electron${_electronversion}/version)"
  export PNPM_HOME="$srcdir/pnpm-home"
  pnpm build-linux
}

check() {
  cd "${pkgname}Plus"
  export PNPM_HOME="$srcdir/pnpm-home"
  node test/folder-structure-testing/populator.mjs
  pnpm test
}

package() {
  cd "${pkgname}Plus"
  install -Dm644 dist/electron/Packaged/linux-unpacked/resources/app.asar -t \
    "$pkgdir/usr/lib/$pkgname/"
  install -Dm755 "$srcdir/$pkgname.sh" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$srcdir/$pkgname.desktop" -t "$pkgdir/usr/share/applications/"

  for i in src/assets/icon/*; do
    install -Dm644 "${i}" \
      "$pkgdir/usr/share/icons/hicolor/$(basename -s .png "${i}")/apps/$pkgname.png"
  done

  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
