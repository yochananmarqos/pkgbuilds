# https://aur.archlinux.org/packages/fresh-editor-bin

pkgname=fresh-editor-bin
_app_id=io.github.sinelaw.fresh
pkgver=0.4.10
pkgrel=1
pkgdesc="A lightweight, fast terminal-based text editor with LSP support and TypeScript plugins"
url="https://getfresh.dev"
license=('GPL-2.0-only')
arch=('x86_64' 'aarch64')
depends=(
  'bash'
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
)
optdepends=(
  'bash-language-server: LSP for Bash'
  'clang: LSP for C/C++'
  'csharp-language-server: LSP for C#'  ## AUR
  'gopls: LSP for Go'
  'jdtls: LSP for Java' ## AUR
  'kotlin-language-server: LSP for Kotlin'  ## AUR
  'lua-language-server: LSP for Lua'
  'marksman: LSP for Markdown'
  'pyright: Alternative LSP for Python'
  'python-lsp-server: Default LSP for Python'
  'rust-analyzer: LSP for Rust'
  'texlab: LSP for LaTeX'
  'typescript-language-server: LSP for TypeScript / JavaScript'
  'yaml-language-server: LSP for YAML'
  'zls: LSP for Zig'
)
provides=("${pkgname%-bin}")
conflicts=("${pkgname%-bin}")
source_x86_64=("${pkgname%-bin}-$pkgver-x86_64-unknown-linux-gnu.tar.xz::https://github.com/sinelaw/fresh/releases/download/v$pkgver/${pkgname%-bin}-x86_64-unknown-linux-gnu.tar.xz")
source_aarch64=("${pkgname%-bin}-$pkgver-aarch64-unknown-linux-gnu.tar.xz::https://github.com/sinelaw/fresh/releases/download/v$pkgver/${pkgname%-bin}-aarch64-unknown-linux-gnu.tar.xz")
sha256sums_x86_64=('4234d3d35b03f406dd853fa88058aa60aaa5555e27af5e33607076e60d763cf3')
sha256sums_aarch64=('0b51c2b30df8d40c5d2a7730a6e7d8b273cedb379a79cd344ab5fa3dd7d6b256')

package() {
  cd "${pkgname%-bin}-${CARCH}-unknown-linux-gnu"
  install -Dm755 fresh -t "$pkgdir/usr/bin/"
  install -Dm644 "fresh.desktop" \
    "$pkgdir/usr/share/applications/fresh.desktop"

  for icon in icons/*/apps/fresh.png; do
    size=$(basename $(dirname $(dirname "$icon")))
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/${size}/apps/fresh.png"
    done

  install -Dm644 README.md -t "$pkgdir/usr/share/doc/${pkgname%-bin}/"

  # See https://github.com/sinelaw/fresh/blob/v$pkgver/docs/internal/packaging-self-update.md
  install -d "$pkgdir/usr/share/$pkgname"
  cat > "$pkgdir/usr/share/$pkgname/install-receipt.toml" <<EOF
schema = 1
channel = "aur-custom-bin"
version = "$pkgver"
package_name = "$pkgname"
managed = false
self_update = false
EOF
}
