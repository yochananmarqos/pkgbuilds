# https://packages.teejeetech.com/tt-flash-usb/public/version.txt

pkgname=tt-flash-usb
pkgver=26.08
pkgrel=1
_distro=debian
_codename=trixie
pkgdesc="Flash ISO and IMG files to USB drive"
arch=('x86_64')
url="https://teejeetech.com"
license=('LicenseRef-proprietary')
depends=(
  '7zip'
  'gtk4'
  'json-glib'
  'libadwaita'
  'libgee'
  'polkit'
)
makedepends=('desktop-file-utils')
source=("https://packages.teejeetech.com/$pkgname/public/${_distro}/${_codename}/amd64/${pkgname}_${pkgver}_amd64.deb")
sha256sums=('98a2e64b80d5b66fa3ed3909427262d1ce634622131b4c83c3802de7a44bf7c2')

prepare() {
  mkdir -p "$pkgname-$pkgver"
  bsdtar -xf data.tar.xz -C "$pkgname-$pkgver"

  cd "$pkgname-$pkgver"
  desktop-file-edit --set-key=StartupWMClass --set-value=com.teejeetech.flash-usb \
    "usr/share/applications/$pkgname.desktop"
}

check() {
  cd "$pkgname-$pkgver"
  desktop-file-validate "usr/share/applications/$pkgname.desktop"
}

package() {
  cd "$pkgname-$pkgver"
  cp -a usr "$pkgdir/"

  install -Dm644 "usr/share/doc/$pkgname/copyright" -t "$pkgdir/usr/share/licenses/$pkgname/"
  rm -rf "$pkgdir/usr/share/doc"
}
