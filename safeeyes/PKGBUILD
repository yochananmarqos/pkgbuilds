# https://aur.archlinux.org/packages/safeeyes

pkgname=safeeyes
_app_id=io.github.slgobinath.SafeEyes
pkgver=3.6.1
pkgrel=1
pkgdesc="Protect your eyes from eye strain using this simple and beautiful, yet extensible break reminder"
arch=('any')
url="https://slgobinath.github.io/safeeyes"
license=('GPL-3.0-or-later')
depends=(
  'alsa-utils'
  'gtk4'
  'hicolor-icon-theme'
  'libnotify'
  'python-babel'
  'python-dbus'
  'python-gobject'
  'python-packaging'
  'python-psutil'
  'python-xlib'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
checkdepends=(
  'appstream'
  'desktop-file-utils'
  'python-pytest'
  'python-time-machine'
)
optdepends=(
  'ffmpeg: Option for Audible Alert plugin'
  'gnome-shell-extension-appindicator: For tray icon support on GNOME'
  'libayatana-appindicator: For tray icon support on MATE'
  'pipewire-audio: Option for Audible Alert plugin'
  'python-croniter: For Health Statistics plugin'
  'python-pywayland: For Smart Pause plugin (Wayland)'
  'safeeyes-plugins: Third party plugins'
  'snixembed: For tray icon support in LXDE/MATE/other WMs'
  'wlrctl: for Do Not Disturb plugin to detect fullscreen (Wayland)'
  'xprintidle: for Smart Pause plugin (Xorg)'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/slgobinath/safeeyes/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fb130620621e0506ff030e4ecc0024ce7ca025c1a968544c8c33370563ea5586')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  python -m venv --clear --without-pip --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -I -m pytest

  appstreamcli validate --no-net "$pkgname/platform/${_app_id}.metainfo.xml"
  desktop-file-validate "$pkgname/platform/${_app_id}.desktop"
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 "$pkgname/platform/${_app_id}.metainfo.xml" -t \
    "$pkgdir/usr/share/metainfo/"
  install -Dm644 "$pkgname/platform/${_app_id}.desktop" -t \
    "$pkgdir/usr/share/applications/"

  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  mv "${pkgdir}${site_packages}/$pkgname/platform/icons" "$pkgdir/usr/share"

  # Remove duplicate files
  rm -rf "${pkgdir}${site_packages}/$pkgname/platform/"
}
