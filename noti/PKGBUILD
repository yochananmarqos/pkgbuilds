# https://aur.archlinux.org/packages/noti

pkgname=noti
pkgver=3.9.0
pkgrel=1
pkgdesc="Monitor a process and trigger a notification"
arch=('x86_64')
url="https://codeberg.org/roble/noti"
license=('MIT')
depends=('glibc')
makedepends=(
  'git'
  'go'
)
source=("git+https://codeberg.org/roble/noti.git#tag=$pkgver")
sha256sums=('3cf05efd3e01ee33c2d66bd5ed9db00c3f7a789b910ec12bd2873a88f4dc1855')

prepare(){
  cd "$pkgname"
  export GOPATH="$srcdir/gopath"
  go mod download -modcacherw
}

build() {
  cd "$pkgname"
  export GOPATH="$srcdir/gopath"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  go build -v \
    -trimpath \
    -buildmode=pie \
    -mod=vendor \
    -modcacherw \
    -ldflags="-linkmode external -extldflags \"${LDFLAGS}\" -s -w -X codeberg.org/roble/noti/internal/command.Version=$pkgver" \
    -o "$pkgname" "./cmd/$pkgname"
}

check() {
  cd "$pkgname"
  export GOPATH="$srcdir/gopath"
  make test
}

package() {
  cd "$pkgname"
  install -Dm755 "$pkgname" -t "$pkgdir/usr/bin/"
  install -Dm644 "docs/man/dist/$pkgname.1" -t "$pkgdir/usr/share/man/man1/"
  install -Dm644 "docs/man/dist/$pkgname.yaml.5" -t "$pkgdir/usr/share/man/man5/"
  install -Dm644 "docs/$pkgname.md" -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 "docs/$pkgname.example.yaml" -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSES/MIT.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
