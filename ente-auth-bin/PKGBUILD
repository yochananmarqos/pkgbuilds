# https://aur.archlinux.org/packages/ente-auth-bin

pkgname=ente-auth-bin
pkgver=4.4.26
pkgrel=1
pkgdesc="Open source 2FA authenticator, with end-to-end encrypted backups"
arch=('x86_64')
url="https://ente.com/auth"
license=('AGPL-3.0-or-later')
depends=(
  'gtk3'
  'libayatana-appindicator'
  'libsecret'
  'libsodium'
  'org.freedesktop.secrets'
  'polkit'
  'sqlite'
  'xdg-user-dirs'
)
makedepends=('chrpath')
provides=("${pkgname%-bin}")
conflicts=("${pkgname%-bin}")
source=("https://github.com/ente/ente/releases/download/auth-v${pkgver}/ente-auth-v${pkgver}-${CARCH}.deb")
sha256sums=('9952ad4c7d9d4774b52df0de53eda4959e4a4662d63ab9eb64aa168013bc3369')

package() {
  bsdtar -xf data.tar.zst -C "${pkgdir}/"

  install -d "${pkgdir}/usr/bin"
  ln -s /usr/share/enteauth/enteauth "${pkgdir}/usr/bin/enteauth"

  install -d "${pkgdir}/usr/share/polkit-1/actions"
  ln -s /usr/share/enteauth/data/flutter_assets/assets/polkit/com.ente.auth.policy \
    "${pkgdir}/usr/share/polkit-1/actions/"

  # Remove insecure RUNPATH pointing to build dir
  chrpath --delete "$pkgdir"/usr/share/enteauth/lib/*.so
}
