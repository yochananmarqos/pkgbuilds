# https://aur.archlinux.org/packages/localsend-bin

pkgname=localsend-bin
pkgver=1.18.2
pkgrel=1
pkgdesc="An open source cross-platform alternative to AirDrop"
arch=('x86_64' 'aarch64')
url="https://localsend.org"
license=('Apache-2.0')
depends=(
  'gtk3'
  'libayatana-appindicator'
  'libepoxy'
  'xdg-user-dirs'
)
makedepends=('desktop-file-utils')
provides=("${pkgname%-*}")
conflicts=("${pkgname%-*}")
source_x86_64=("https://github.com/localsend/localsend/releases/download/v${pkgver}/LocalSend-${pkgver}-linux-x86-64.deb"
               "https://github.com/localsend/localsend/releases/download/v${pkgver}/LocalSend-CLI-${pkgver}-linux-x86-64.tar.gz")
source_aarch64=("https://github.com/localsend/localsend/releases/download/v${pkgver}/LocalSend-${pkgver}-linux-arm-64.deb"
                "https://github.com/localsend/localsend/releases/download/v${pkgver}/LocalSend-CLI-${pkgver}-linux-arm-64.tar.gz" )
noextract=("LocalSend-CLI-${pkgver}"*)
sha256sums_x86_64=('cc42a4f3eacdcb25ec31f0016b1272acb003145ab30484db8965450e20c72cd2'
                   'f5a986e0b4701b9aafeb9747225a2f3e314e97aba61b3dd7c9d076226f512b08')
sha256sums_aarch64=('bbd8347b7979f936d3bae176a3f0d9b81431605707c585270d6240f7670feb1f'
                    'b003e9837743470f7a423ca1205e664031ce3d2e865acc692f3e47577ea93f6d')

prepare() {
  mkdir -p "${pkgname%-*}-$pkgver"
  bsdtar -xf data.tar.zst -C "${pkgname%-*}-$pkgver"

  if [ $CARCH == "aarch64" ]; then
    bsdtar -xf LocalSend-CLI-${pkgver}-linux-arm-64.tar.gz -C "${pkgname%-*}-$pkgver"
  else
    bsdtar -xf LocalSend-CLI-${pkgver}-linux-x86-64.tar.gz -C "${pkgname%-*}-$pkgver"
  fi

  cd "${pkgname%-*}-$pkgver"
  desktop-file-edit \
    --set-key=Exec --set-value="${pkgname%-*}" \
    --set-key=StartupWMClass --set-value="org.${pkgname%-*}.${pkgname%-*}_app" \
    --set-icon="${pkgname%-*}" \
    "usr/share/applications/${pkgname%-*}_app.desktop"
}

package() {
  cd "${pkgname%-*}-$pkgver"
  install -Dm755 "${pkgname%-*}-cli" -t "${pkgdir}/usr/bin/"

  install -Dm755 "opt/${pkgname%-*}_app/${pkgname%-*}_app" \
    "${pkgdir}/opt/${pkgname%-*}/${pkgname%-*}"
  cp -a "opt/${pkgname%-*}_app"/{data,lib} "${pkgdir}/opt/${pkgname%-*}"

  ln -s "/opt/${pkgname%-*}/${pkgname%-*}" "${pkgdir}/usr/bin/${pkgname%-*}"

  for res in 128x128 256x256; do
    install -Dm644 "usr/share/icons/hicolor/${res}/apps/${pkgname%-*}_app.png" \
      "${pkgdir}/usr/share/icons/hicolor/${res}/apps/${pkgname%-*}.png"
  done

  install -Dm644 "usr/share/applications/${pkgname%-*}_app.desktop" \
    "${pkgdir}/usr/share/applications/${pkgname%-*}.desktop"
}
